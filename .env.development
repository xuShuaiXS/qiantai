# 开发环境
VITE_APP_TITLE=极光AI
# 相对路径走 Vite 代理 → http://192.168.50.30:8080（见 vite.config.ts）
VITE_API_BASE_URL=/api/v1

# 登录策略：false = 免登录，打开站点直接进首页（内网演示/联调用）
#           true  = 走正常登录页流程
VITE_REQUIRE_LOGIN=false

# 免登录模式下用于静默换取 token 的账号（用户看不到登录过程）
# 正式部署请改为 true，或换成专用账号
VITE_AUTO_LOGIN_USERNAME=admin
VITE_AUTO_LOGIN_PASSWORD=123456

# 超级智能体数据源：
#   为空       = 前端 Mock（内置种子数据 + localStorage 持久化，无需启动后端）
#   /agent-api = 本地 Nest 后端 agent-server（pnpm -C D:/jiguangAI-github/agent-server start，端口 3000）
VITE_AGENTS_API=/agent-api
